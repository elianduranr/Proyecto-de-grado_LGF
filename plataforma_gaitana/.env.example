# Configuración local. No poner credenciales en archivos versionados.
LEGACY_ROOT=..
STORAGE_PATH=./storage
# SQLite sólo para revisar el prototipo sin servidor SQL.
# SQL Server: mssql+pyodbc://usuario:clave@servidor/proyectos?driver=ODBC+Driver+18+for+SQL+Server
DATABASE_URL=sqlite:///./storage/prototipo.db
# Si SQL_SERVER tiene valor, se usa SQL Server en lugar de DATABASE_URL.
SQL_SERVER=
SQL_DATABASE=proyectos
# Esquema de todas las tablas de la plataforma: EP (definido en modelos y migraciones).
SQL_USER=
SQL_PASSWORD=
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_TRUST_CERTIFICATE=no
# Fuente de cortes WebFlor; distinta del destino Proyectos.EP. Solo lectura.
WEBFLOR_SERVER=
WEBFLOR_DATABASE=WF_Gaitana
WEBFLOR_USER=
WEBFLOR_PASSWORD=
WEBFLOR_DRIVER=ODBC Driver 18 for SQL Server
WEBFLOR_TRUST_CERTIFICATE=no
DEV_MODE=true
API_ADMIN_TOKEN=
API_ENGINEER_TOKEN=
API_VIEWER_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
